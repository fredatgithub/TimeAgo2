<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeAgo2.SettingsPage"
             Title="Paramètres"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}">
    <VerticalStackLayout Padding="24,28"
                         Spacing="20">
        <VerticalStackLayout Spacing="6">
            <Label x:Name="PageTitleLabel"
                   Text="Paramètres"
                   FontSize="28"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            <Label x:Name="PageSubtitleLabel"
                   Text="Choisissez la langue de l’application."
                   FontSize="15"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
        </VerticalStackLayout>

        <Border Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="LanguageLabel"
                       Text="Langue"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Picker x:Name="LanguagePicker"
                        Title="Langue"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>
        </Border>

        <Border x:Name="ThemeBorder"
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                Stroke="{AppThemeBinding Light={StaticResource DividerLight}, Dark={StaticResource DividerDark}}"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="ThemeLabel"
                       Text="Thème"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Picker x:Name="ThemePicker"
                        Title="Thème"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </VerticalStackLayout>
        </Border>

        <Button x:Name="SaveButton"
                Text="Enregistrer"
                Clicked="OnSaveClicked"
                BackgroundColor="#FF5722"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="26"
                HeightRequest="50" />

        <Button x:Name="AboutButton"
                Text="À propos"
                Clicked="OnAboutClicked"
                BackgroundColor="#FF5722"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                FontAttributes="Bold"
                CornerRadius="26"
                HeightRequest="50" />
    </VerticalStackLayout>
</ContentPage>
