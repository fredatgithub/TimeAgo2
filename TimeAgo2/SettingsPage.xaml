<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeAgo2.SettingsPage"
             Title="Paramètres"
             BackgroundColor="White">
    <VerticalStackLayout Padding="24,28"
                         Spacing="20">
        <VerticalStackLayout Spacing="6">
            <Label x:Name="PageTitleLabel"
                   Text="Paramètres"
                   FontSize="28"
                   TextColor="#212121" />
            <Label x:Name="PageSubtitleLabel"
                   Text="Choisissez la langue de l’application."
                   FontSize="15"
                   TextColor="#757575" />
        </VerticalStackLayout>

        <Border Padding="18"
                BackgroundColor="#FAFAFA"
                Stroke="#EEEEEE"
                StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="LanguageLabel"
                       Text="Langue"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#424242" />
                <Picker x:Name="LanguagePicker"
                        Title="Langue"
                        TextColor="#212121" />
            </VerticalStackLayout>
        </Border>

        <Button x:Name="SaveButton"
                Text="Enregistrer"
                Clicked="OnSaveClicked"
                BackgroundColor="#FF5722"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="26"
                HeightRequest="50" />

        <Button x:Name="AboutButton"
                Text="À propos"
                Clicked="OnAboutClicked"
                BackgroundColor="#BBDEFB"
                TextColor="#424242"
                FontAttributes="Bold"
                CornerRadius="26"
                HeightRequest="50" />
    </VerticalStackLayout>
</ContentPage>
