<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeAgo2.SettingsPage"
             Title="Paramètres"
             BackgroundColor="#F4F7FA">
    <VerticalStackLayout Padding="24,28"
                         Spacing="20">
        <VerticalStackLayout Spacing="6">
            <Label x:Name="PageTitleLabel"
                   Text="Paramètres"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#182B28" />
            <Label x:Name="PageSubtitleLabel"
                   Text="Choisissez la langue de l’application."
                   FontSize="15"
                   TextColor="#65736F" />
        </VerticalStackLayout>

        <Border Padding="18"
                BackgroundColor="White"
                Stroke="#E5EBE9"
                StrokeShape="RoundRectangle 20">
            <VerticalStackLayout Spacing="10">
                <Label x:Name="LanguageLabel"
                       Text="Langue"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#46534F" />
                <Picker x:Name="LanguagePicker"
                        Title="Langue"
                        TextColor="#182B28" />
            </VerticalStackLayout>
        </Border>

        <Button x:Name="SaveButton"
                Text="Enregistrer"
                Clicked="OnSaveClicked"
                BackgroundColor="#27685A"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="14"
                HeightRequest="50" />
    </VerticalStackLayout>
</ContentPage>
