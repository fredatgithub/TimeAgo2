<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TimeAgo2.AboutPage"
             Title="À propos"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="24,28"
                             Spacing="20">
            <VerticalStackLayout Spacing="6">
                <Label x:Name="TitleLabel"
                       Text="À propos de TimeAgo2"
                       FontSize="28"
                       TextColor="#212121" />
                <Label x:Name="SubtitleLabel"
                       Text="Suivez le temps écoulé depuis vos activités."
                       FontSize="15"
                       TextColor="#757575" />
            </VerticalStackLayout>

            <Border Padding="18"
                    BackgroundColor="#FAFAFA"
                    Stroke="#EEEEEE"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="DescriptionLabel"
                           FontSize="16"
                           TextColor="#424242" />

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Label x:Name="VersionLabel"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#424242" />
                        <Label x:Name="VersionValueLabel"
                               Grid.Column="1"
                               FontSize="14"
                               TextColor="#757575" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Label x:Name="AuthorLabel"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#424242" />
                        <Label x:Name="AuthorValueLabel"
                               Grid.Column="1"
                               Text="Freddy Juhel"
                               FontSize="14"
                               TextColor="#757575" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Label x:Name="ContactLabel"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#424242" />
                        <Label x:Name="ContactValueLabel"
                               Grid.Column="1"
                               Text="domaine75 at gmail dot com"
                               FontSize="14"
                               TextColor="#757575" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="8">
                        <Label x:Name="WebsiteLabel"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="#424242" />
                        <Label x:Name="WebsiteValueLabel"
                               Grid.Column="1"
                               Text="github.com/fredatgithub/TimeAgo2"
                               FontSize="14"
                               TextColor="#1976D2"
                               TextDecorations="Underline">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnWebsiteTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="BackButton"
                    Text="Retour aux paramètres"
                    Clicked="OnBackClicked"
                    BackgroundColor="#FF5722"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="26"
                    HeightRequest="50" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
